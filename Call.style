  font-size: 2rem;
  margin-bottom: 20px;
}

.cta p {
  font-size: 1.1rem;
  max-width: 600px;
  margin: 0 auto 30px;
}

.cta .btn {
  background-color: #000;
  color: #00ffcc;
  padding: 12px 30px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
}

.cta .btn:hover {
  background-color: #222;
