<!-- Hero Section -->
<section class="hero">
  <div class="container">
    <h1>InnChanger</h1>
    <p>The Ultimate AI Platform for Face Changing, 3D Animation & Film Editing.</p>
    <a href="#features" class="btn">Explore Features</a>
  </div>
</section>￼Enter.hero {
  background: linear-gradient(135deg, #00ffcc 0%, #001f1f 100%);
  color: #000;
  padding: 100px 20px;
  text-align: center;
}

.hero h1 {
  font-size: 3rem;
  margin-bottom: 20px;
}

.hero p {
  font-size: 1.2rem;
  max-width: 600px;
  margin: 0 auto 30px;
}

.hero .btn {
  background-color: #000;
  color: #00ffcc;
  padding: 12px 30px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
  transition: background 0.3s;
}

.hero .btn:hover {
  background-color: #333;
}<!-- Testimonials -->
<section class="testimonials">
  <div class="container">
    <h2>What Users Say</h2>
    <div class="testimonial-grid">

      <div class="testimonial">
        <p>"InnChanger changed how we make content! Face swapping is magical!"</p>
        <span>- Sarah, Filmmaker</span>
      </div>

      <div class="testimonial">
        <p>"No other platform supports Kinyarwanda AI like this. Love it!"</p>
        <span>- Jean Paul, YouTuber</span>
      </div>

      <div class="testimonial">
        <p>"My videos now look like Hollywood productions. Game-changer!"</p>
        <span>- Maya, Creative Director</span>
      </div>

    </div>
  </div>
</section>.testimonials {
  background-color: #0d0d0d;
  padding: 70px 20px;
  color: #fff;
  text-align: center;
}

.testimonial-grid {
  display: grid;
  gap: 30px;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  max-width: 1000px;
  margin: 0 auto;
}

.testimonial {
  background-color: #1a1a1a;
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0,255,204,0.1);
  font-style: italic;
}

.testimonial span {
  display: block;
  margin-top: 10px;
  font-weight: bold;
  color: #00ffcc;
}
